# FastAPI + SQLAlchemy (backend). Copy to `.env` at the repo root.
# Never commit real values.

DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# Supabase Auth (backend verifies JWTs; seed uses the service role)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Optional LLM + embeddings (UniHive AI). Same OpenAI-compatible base URL.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Optional SMTP for emergency emails (leave blank to log only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Next.js public keys. Also copy these two into frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias if the dashboard still shows "anon" instead of "publishable"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
